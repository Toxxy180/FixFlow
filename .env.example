# Supabase -> Connect -> Transaction pooler (runtime)
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require"
# Supabase -> Connect -> Session pooler (migrations, IPv4 compatible)
DIRECT_URL="postgresql://USER:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
DEMO_AUTH="false"
# URL of this app, without a path. Set the HTTPS production URL on Vercel.
APP_URL="http://localhost:3000"
